     <property name="styleSheet">
      <string notr="true">/* Style général du QTabWidget */
QTabWidget {
    background: transparent; /* Fond transparent */
    border: 2px solid #007acc; /* Bordure bleue */
    border-radius: 8px; /* Coins arrondis */
    padding: 4px; /* Espacement intérieur */
}



/* Style des onglets */
QTabBar::tab {
    background-color: rgba(240, 240, 240, 0.8); /* Fond gris clair avec transparence */
    color: #333333; /* Texte gris foncé */
    padding: 8px 16px; /* Espacement intérieur */
    border: 1px solid #cccccc; /* Bordure légère */
    border-bottom: none; /* Pas de bordure en bas */
    border-top-left-radius: 6px; /* Coin arrondi en haut à gauche */
    border-top-right-radius: 6px; /* Coin arrondi en haut à droite */
    margin-right: 4px; /* Espacement entre les onglets */
    font-size: 14px; /* Taille de police */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Police moderne */
}

/* Onglet sélectionné */
QTabBar::tab:selected {
    background-color: rgba(0, 122, 204, 0.9); /* Fond bleu avec transparence */
    color: white; /* Texte blanc */
    border-color: #007acc; /* Bordure bleue */
    font-weight: bold; /* Texte en gras */
}

/* Effet hover sur les onglets */
QTabBar::tab:hover {
    background-color: rgba(224, 224, 224, 0.8); /* Fond gris plus clair au survol */
    color: #007acc; /* Texte bleu au survol */
}



/* Style de la barre d'onglets */
QTabBar {
    background: transparent; /* Fond transparent */
    border: none; /* Pas de bordure */
    spacing: 4px; /* Espacement entre les onglets */
}

/* Style du bouton de fermeture des onglets (si applicable) */
QTabBar::close-button {
    background: transparent; /* Fond transparent */
    padding: 4px; /* Espacement intérieur */
    border-radius: 2px; /* Coins légèrement arrondis */
}

QTabBar::close-button:hover {
    background: rgba(255, 68, 68, 0.8); /* Fond rouge avec transparence au survol */
    color: white; /* Texte blanc */
}

/* Style général pour les QLabel */
QLabel {
    font-size: 14px; /* Taille de police */
    color: white; /* Texte gris foncé */
    background-color: transparent; /* Fond transparent */
    border: 2px solid #007acc; /* Bordure bleue */
    border-radius: 6px; /* Coins arrondis */
 
    margin: 4px; /* Marge extérieure */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Police moderne */
font-weight: bold; /* Texte en gras */
}

/* Effet hover pour QLabel */
QLabel:hover {
    background-color: rgba(240, 248, 255, 0.8); /* Fond bleu clair avec transparence au survol */
    border-color: #005fa3; /* Bordure plus foncée au survol */
}

/* Style pour QLineEdit */
QLineEdit {
    font-size: 14px; /* Taille de police */
    color: #333333; /* Texte gris foncé */
    background-color: transparent; /* Fond transparent */
    border: 2px solid #007acc; /* Bordure bleue */
    border-radius: 6px; /* Coins arrondis */
  
    margin: 4px; /* Marge extérieure */
   font-weight: bold; /* Texte en gras */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Police moderne */
}

/* Effet focus pour QLineEdit */
QLineEdit:focus {
    border: 2px solid #005fa3; /* Bordure plus foncée lors du focus */
    background-color: rgba(240, 248, 255, 0.8); /* Fond bleu clair avec transparence lors du focus */
}

/* Style pour QPushButton */
QPushButton {
    font-size: 14px; /* Taille de police */
    color: white; /* Texte blanc */
    background-color: rgba(0, 122, 204, 0.8); /* Fond bleu avec transparence */
    border: 2px solid #007acc; /* Bordure bleue */
    border-radius: 6px; /* Coins arrondis */
    padding: 8px 16px; /* Espacement intérieur */
    margin: 4px; /* Marge extérieure */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Police moderne */
    font-weight: bold; /* Texte en gras */
}

/* Effet hover pour QPushButton */
QPushButton:hover {
    background-color: rgba(0, 95, 163, 0.8); /* Fond bleu plus foncé avec transparence au survol */
    border-color: #005fa3; /* Bordure plus foncée au survol */
}

/* Effet pressé pour QPushButton */
QPushButton:pressed {
    background-color: rgba(0, 79, 140, 0.8); /* Fond bleu encore plus foncé avec transparence lors du clic */
    border-color: #004f8c; /* Bordure encore plus foncée lors du clic */
}

/* Style pour QPushButton désactivé */
QPushButton:disabled {
    background-color: rgba(204, 204, 204, 0.8); /* Fond gris avec transparence */
    border-color: #cccccc; /* Bordure grise */
    color: #666666; /* Texte gris foncé */
} </string>
