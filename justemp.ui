    background: rgba(0, 162, 232, 0.2); /* Bleu un peu plus marqué */
}

/* --- Sélection d'une cellule --- */
QTableView::item:selected {
    background: rgba(0, 162, 232, 0.5); /* Bleu plus visible */
    color: black;
}

/* --- En-têtes de colonnes --- */
QHeaderView::section {
    background-color: rgba(0, 162, 232, 0.6); /* Bleu plus profond */
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
    font-size: 12pt;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
}

/* --- En-têtes des lignes --- */
/* --- En-têtes des lignes --- */
QHeaderView::section:vertical {
    background: rgba(0, 162, 232, 0.3);
    color: white;
    font-weight: bold;
    border-right: 2px solid rgba(255, 255, 255, 0.5);
}
/* Style pour QTextEdit */
QTextEdit {
    font-size: 14px; /* Taille de police */
    color: #333333; /* Texte gris foncé */
    background-color: rgba(240, 248, 255, 0.8); /* Fond bleu clair avec transparence */
    border: 2px solid #007acc; /* Bordure bleue */
    border-radius: 6px; /* Coins arrondis */
    padding: 8px; /* Espacement intérieur */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Police moderne */
    font-weight: normal; /* Texte normal */
}

/* Effet focus pour QTextEdit */
QTextEdit:focus {
    border: 2px solid #005fa3; /* Bordure plus foncée lors du focus */
    background-color: rgba(224, 248, 255, 0.8); /* Fond bleu clair un peu plus marqué lors du focus */
}

/* Effet hover pour QTextEdit */
QTextEdit:hover {
    background-color: rgba(224, 248, 255, 0.9); /* Fond bleu clair un peu plus marqué au survol */
}
