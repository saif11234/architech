}

/* Supprimer la flèche du QComboBox et l'icône du QDateEdit */
QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    background: transparent;
}

/* Style de la liste déroulante du QComboBox */
QComboBox QAbstractItemView {
    background-color: #2D2D2D; /* Même fond que le formulaire */
