         <property name="styleSheet">
          <string notr="true">QLineEdit, QDateEdit, QComboBox {
    border: 2px solid #3A7ECF;  /* Bordure bleue */
    border-radius: 5px;
    background-color: transparent; /* Fond transparent */
    color: white;
    padding: 5px;
    font-size: 14px;
}

/* Supprimer la flèche du QComboBox et l'icône du QDateEdit */
QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    background: transparent;
}

/QComboBox QAbstractItemView {
    background-color: #2D2D2D; /* Même fond que le formulaire */
    border: 1px solid #3A7ECF;
    /*selection-background-color: #3A7ECF;*/
selection-background-color: white;
}


/* Style des boutons haut/bas du QDateEdit */
QDateEdit::up-button, QDateEdit::down-button {
    background: transparent;
    border: none;
}
