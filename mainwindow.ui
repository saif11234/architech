    <property name="styleSheet">
     <string notr="true">/* Fond de la sidebar */
QFrame {
    background-color: #2c3e50;  /* Un fond sombre professionnel */
    border-right: 2px solid #34495e; /* Ajout d'une bordure droite */
    
}
/* Style des boutons de la sidebar */
QPushButton {
    background-color: transparent; /* Fond transparent */
    color: white;                 /* Texte en blanc */
    border: none;                 /* Pas de bordure */
    font-size: 18px;              /* Taille de police */
    padding: 5px;                 /* Espacement intérieur */
    text-align: left 5px;             /* Alignement du texte à gauche */
    border-radius: 5px;           /* Coins arrondis */
    min-width: 180px;             /* Largeur minimale */
}

/* Effet au survol */
QPushButton:hover {
    background-color: #16a085;    /* Couleur de fond au survol */
    font-weight: bold;            /* Texte en gras */
}

/* Effet quand le bouton est pressé */
QPushButton:pressed {
    background-color: #1abc9c;    /* Couleur de fond quand pressé */
}

/* Suppression du contour de focus */
QPushButton:focus {
    outline: none;                /* Enlève le contour quand le bouton est activé */
}

/* Style général des boutons */
QPushButton:!pressed {
    margin-bottom: 5px;           /* Espacement entre les boutons */
}
/* Optionnel : ajout d'un effet de survol global pour le frame */
QFrame:hover {
    background-color: #34495e;  /* Change la couleur de fond lors du survol de la sidebar */
}
</string>
    </property>
    <property name="frameShape">
     <enum>QFrame::Shape::StyledPanel</enum>
    </property>
    <property name="frameShadow">
     <enum>QFrame::Shadow::Raised</enum>
    </property>
