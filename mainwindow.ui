         <property name="styleSheet">
          <string notr="true">QGroupBox {
    border: 2px solid rgba(255, 255, 255, 0.5); /* Bordure semi-transparente */
    border-radius: 10px; /* Coins arrondis */
    margin-top: 10px; /* Espace au-dessus du titre */
    padding: 10px;
    background: rgba(0, 0, 0, 0.2); /* Fond semi-transparent */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center; /* Titre centré en haut */
    padding: 5px 10px;
    color: white;
    font-size: 14px;
    font-weight: bold;
    background: rgba(0, 123, 255, 0.6); /* Fond coloré pour le titre */
    border-radius: 5px;
}

QRadioButton {
    color: white;
    font-size: 12px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:checked {
    background-color: #007bff; /* Couleur bleue quand sélectionné */
    border: 2px solid white;
    border-radius: 8px;
}
</string>
         </property>
