     <property name="styleSheet">
      <string notr="true">image: url(:/logo.jpg);
QLabel {
    border: 2px solid #3498db;  /* Bordure bleue de 2px */
    border-radius: 8px;         /* Coins légèrement arrondis */
    padding: 10px;              /* Espacement intérieur */
    background-color: #f9f9f9;  /* Fond légèrement gris pour un look moderne */
    color: #2c3e50;             /* Couleur du texte sombre pour un bon contraste */
    font-size: 14px;            /* Taille de police */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Police moderne */
    text-align: center;         /* Centrer le texte */
    min-width: 120px;           /* Largeur minimale */
    min-height: 40px;           /* Hauteur minimale */
}

/* Effet au survol */
QLabel:hover {
    background-color: #ecf0f1;  /* Changement de fond au survol */
    border-color: #2980b9;      /* Bordure plus foncée au survol */
}

/* Effet quand le label est &quot;pressé&quot; ou actif */
QLabel:pressed {
    background-color: #bdc3c7;  /* Fond plus sombre quand pressé */
    border-color: #1c5980;      /* Bordure encore plus foncée */
}</string>
     </property>
     <property name="text">
      <string/>
     </property>
    </widget>
