     <property name="styleSheet">
      <string notr="true">/* Style général du label */
QLabel {
    background-color: transparent;  /* Fond transparent pour éviter un arrière-plan gênant */
    color: #ecf0f1;  /* Texte de couleur claire pour un contraste avec un fond sombre */
    font-size: 24px;  /* Taille de la police plus grande pour un titre */
    font-family: &quot;Helvetica Neue&quot;, sans-serif;  /* Police moderne et lisible */
    font-weight: bold;  /* Donner un poids au texte */
    text-align: center;  /* Centrer le texte */
    border: none;
    padding: 20px;
    border-radius: 10px;  /* Arrondir les bords du label */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);  /* Ajoute une ombre subtile pour l'effet 3D */
}

/* Effet lors du survol */
QLabel:hover {
    color: #16a085;  /* Change la couleur du texte au survol */
    cursor: pointer;  /* Change le curseur pour un effet interactif */
}

/* Optionnel: Effet de focus ou de sélection */
QLabel:focus {
    outline: none;
    border: 2px solid #1abc9c;  /* Bordure subtile pour l'élément sélectionné */
}
</string>
