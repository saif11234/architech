          <property name="styleSheet">
           <string notr="true">.etat-container {
    background-color: rgba(255, 255, 255, 0.2); /* Fond semi-transparent */
    border: 2px solid white; /* Bordure blanche */
    padding: 10px;
    border-radius: 10px;
    display: inline-block;
}

.etat-container label {
    color: white;
    font-weight: bold;
    margin-right: 10px;
}

.etat-container input[type=&quot;radio&quot;] {
    accent-color: white; /* Change la couleur des boutons radio */
    transform: scale(1.2); /* Agrandir un peu les boutons radio */
}</string>
