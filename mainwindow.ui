         <property name="styleSheet">
          <string notr="true">QLineEdit, QDateEdit, QComboBox {
    border: 2px solid #3A7ECF;  /* Bordure bleue */
    border-radius: 5px;
    background-color: transparent; /* Fond transparent */
    color: white;
