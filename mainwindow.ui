        <string>lister</string>
       </attribute>
       <widget class="QTableView" name="tableRessource">
        <property name="geometry">
         <rect>
          <x>-5</x>
          <y>90</y>
          <width>491</width>
          <height>301</height>
         </rect>
        </property>
        <property name="styleSheet">
         <string notr="true">/* Style général pour le tableau */
QTableView {
    background-color: #ffffff; /* Fond blanc */
    border: 1px solid #e0e0e0; /* Bordure légère */
    gridline-color: #e0e0e0; /* Couleur des lignes de la grille */
    font-family: Arial, sans-serif; /* Police */
    font-size: 10px; /* Taille de la police réduite */
    selection-background-color: transparent; /* Désactiver la couleur de fond de la sélection */
    selection-color: inherit; /* Conserver la couleur du texte d'origine */
}

/* Style pour l'en-tête du tableau */
QHeaderView::section {
    background-color: #2196F3; /* Couleur de fond de l'en-tête (bleu) */
    color: white; /* Couleur du texte */
    padding: 0px; /* Espacement interne réduit */
    font-weight: bold; /* Texte en gras */
    border: 1px solid #1E88E5; /* Bordure */
    font-size: 11px; /* Taille de la police réduite */
    text-align: center; /* Alignement du texte au centre */
}

/* Désactiver la sélection des en-têtes */
QHeaderView::section:selected {
    background-color: #2196F3; /* Conserver la couleur de fond de l'en-tête */
    color: white; /* Conserver la couleur du texte */
}

/* Style pour les cellules du tableau */
QTableView::item {
    padding: 1px; /* Espacement interne réduit */
    border: 1px solid #e0e0e0; /* Bordure légère */
    color: #333333; /* Couleur du texte */
    text-align: center; /* Alignement horizontal au centre */
    vertical-align: middle; /* Alignement vertical au centre */
}

/* Désactiver la sélection des cellules */
QTableView::item:selected {
    background-color: transparent; /* Fond transparent pour les cellules sélectionnées */
    color: inherit; /* Conserver la couleur du texte d'origine */
}

/* Style pour les boutons */
QPushButton {
    background-color: #2196F3; /* Couleur de fond (bleu) */
    color: white; /* Couleur du texte */
    padding: 3px 8px; /* Espacement interne réduit */
    border: none; /* Pas de bordure */
    border-radius: 3px; /* Coins arrondis réduits */
    font-size: 12px; /* Taille de la police réduite */
    font-weight: bold; /* Texte en gras */
}

QPushButton:hover {
    background-color: #1E88E5; /* Couleur de fond au survol (bleu plus foncé) */
}

/* Style pour les champs de saisie */
QLineEdit {
    padding: 2px; /* Espacement interne réduit */
    border: 1px solid #ccc; /* Bordure */
    border-radius: 3px; /* Coins arrondis réduits */
    font-size: 12px; /* Taille de la police réduite */
    background-color: #f9f9f9; /* Fond légèrement gris */
}

/* Style pour les cases à cocher */
QCheckBox {
    spacing: 3px; /* Espacement réduit entre la case et le texte */
    font-size: 12px; /* Taille de la police réduite */
}

QCheckBox::indicator {
    width: 14px; /* Largeur de la case réduite */
    height: 14px; /* Hauteur de la case réduite */
}

/* Style pour les boutons radio */
QRadioButton {
    spacing: 3px; /* Espacement réduit entre le bouton et le texte */
    font-size: 12px; /* Taille de la police réduite */
}

QRadioButton::indicator {
    width: 14px; /* Largeur du bouton réduite */
    height: 14px; /* Hauteur du bouton réduite */
}

/* Style pour les dates */
QDateEdit {
    padding: 3px; /* Espacement interne réduit */
    border: 1px solid #ccc; /* Bordure */
    border-radius: 3px; /* Coins arrondis réduits */
    font-size: 12px; /* Taille de la police réduite */
    background-color: #f9f9f9; /* Fond légèrement gris */
}

/* Style pour les titres */
QLabel {
    font-size: 12px; /* Taille de la police réduite */
    font-weight: bold; /* Texte en gras */
    color: #333333; /* Couleur du texte */
}

/* Style pour les sous-titres */
QLabel#subtitle {
    font-size: 10px; /* Taille de la police réduite */
    color: #666666; /* Couleur du texte */
}

/* Style pour les séparateurs */
QFrame#separator {
    background-color: #e0e0e0; /* Couleur de fond */
    border: none; /* Pas de bordure */
    height: 1px; /* Hauteur */
}
* Style pour l'en-tête du tableau */
QHeaderView::section {
    background-color: #2196F3; /* Couleur de fond de l'en-tête (bleu) */
    color: white; /* Couleur du texte */
    padding: 0px; /* Supprimer l'espacement interne */
    font-weight: bold; /* Texte en gras */
    border: none; /* Supprimer la bordure */
    font-size: 12px; /* Taille de la police réduite */
    text-align: center; /* Alignement du texte au centre */
    margin: 0px; /* Supprimer les marges entre les sections */
}

/* Désactiver la sélection des en-têtes */
QHeaderView::section:selected {
    background-color: #2196F3; /* Conserver la couleur de fond de l'en-tête */
    color: white; /* Conserver la couleur du texte */
}</string>
        </property>
       </widget>
